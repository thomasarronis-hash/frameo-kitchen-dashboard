# Variables du BFF (serveur/config.js). Copier en .env (non versionné) et ne remplir que ce qui change.
# Valeur vide = valeur par défaut, indiquée en commentaire. « Clevo » = le PC d'administration (outils/cadre.mjs),
# « M900 » = le petit serveur maison qui fait tourner Home Assistant, Immich et ce serveur en Docker.

# URL de Home Assistant, sans chemin (défaut : http://192.168.1.187:8123, à adapter ; en Docker : http://host.docker.internal:8123)
HA_URL=
# Fichier du jeton longue durée de l'utilisateur HA « Mur », non admin, en 600 (défaut : ~/.config/cadre/ha_token_dev)
HA_JETON_FICHIER=
# Clé d'appareil du cadre, 32 octets aléatoires en hexadécimal, en 600 (défaut : ~/.config/cadre/cle_dev)
CLE_CADRE_FICHIER=
# Clé d'appareil du Clevo (outils/cadre.mjs), différente de celle du cadre, en 600 ; seule à ouvrir /api/etat et
# GET /api/courses. Créée toute seule si absente, en développement seulement (défaut : ~/.config/cadre/cle_clevo_dev)
CLE_CLEVO_FICHIER=
# Port d'écoute (défaut : 8020)
PORT=
# Adresse d'écoute (défaut : 127.0.0.1 ; en Docker : 0.0.0.0)
HOTE=
# Dossier de la page, relatif à la racine du projet ou absolu (défaut : web/dist ; web avec npm run dev)
DOSSIER_WEB=
# Dossier des menus publiés, relatif à la racine du projet ou absolu (défaut : data/menus)
DOSSIER_MENUS=
# Dossier de l'état local (drive.json, draps.json, tempo.json, enfants/ : journées et registre des points), relatif à la
# racine du projet ou absolu (défaut : data/etat). À sauvegarder ; un fichier abîmé y est mis de côté en *.abime-<date>.
DOSSIER_ETAT=
# 1 = les actions courses_* écrivent VRAIMENT dans Home Assistant (todo.shopping_list). Toute autre valeur, ou vide :
# simulation, rien n'est écrit.
ACTIONS_REELLES=
# 1 = les actions MAISON (touches des télécommandes Apple TV et TCL, appli de l'Apple TV, direct de la sonnette)
# agissent VRAIMENT dans Home Assistant. Toute autre valeur, ou vide : simulation, rien n'est envoyé à la maison
# (bandeau « Mode essai » sur l'écran Maison). Garde-fou séparé de ACTIONS_REELLES. Aucune action d'alarme n'existe, quelle que soit cette valeur.
ACTIONS_MAISON=
# 1 = les commandes de la VOITURE (commencer la charge, démarrer la clim, appel de phares, klaxon, niveaux de charge
# mini et cible, rôles de VOITURES) agissent VRAIMENT par Home Assistant. Toute autre valeur, ou vide : simulation, rien
# n'est envoyé à la voiture (« Mode essai » sur l'écran Voitures). Garde-fou séparé de ACTIONS_REELLES et ACTIONS_MAISON.
# Pas de protection contre les enfants, seulement les limites du serveur pour le quota de l'API Renault (même commande toutes les 30 s, même réglage toutes les 10 s, 10 commandes par
# heure glissante toutes voitures confondues).
ACTIONS_VOITURE=
# 1 = les commandes des CLIMS (marche, mode, consigne, ventilation, oscillations, options de CLIMS) agissent VRAIMENT par
# Home Assistant. Toute autre valeur, ou vide : simulation, rien n'est envoyé aux clims (« Mode essai » sur l'écran Clims).
# Garde-fou séparé des trois autres. Pas de protection contre les enfants, seulement les limites du serveur (même
# commande toutes les 2 s, 120 commandes par heure glissante).
ACTIONS_CLIM=
# Fichier secret du Wi-Fi invités, en 600 : { "ssid": "...", "mot_de_passe": "...", "securite": "WPA2" } (WPA, WPA2,
# WPA3 ou nopass). Défaut : vide, « pas encore prêt, à préparer sur le serveur » sur l'écran Maison. Relu à chaque demande.
WIFI_INVITES_FICHIER=
# API de go2rtc, sans chemin (défaut : http://192.168.1.187:1984 ; en Docker : http://host.docker.internal:1984)
GO2RTC_URL=
# Nom du flux de la sonnette dans GET <GO2RTC_URL>/api/streams (numéro de série, T8210...) : à ne pas versionner.
# Défaut : vide, pas de direct vidéo, pas de bouton « Voir le direct ». À NE PAS remplir tant que go2rtc écoute le réseau
# local sans authentification (README, « Sonnette », risque du direct) : la clé du cadre ne protégerait rien.
GO2RTC_FLUX_SONNETTE=
# Calendriers lus par l'agenda (liste blanche), chacun associé à la personne dont il porte les rendez-vous, séparés par
# des virgules : calendar.domicile=Camille,calendar.travail=Camille (défaut : vide, aucun agenda relié). Le prénom ne sert
# que d'étiquette : initiale et couleur sur la page, une couleur par personne. Voir le README, « Agenda ».
AGENDA_CALENDRIERS=
# Voitures électriques (intégration Renault de HA, README « Voitures »), deux au plus, séparées par « ; » :
# Mégane: batterie=sensor.xxx_batterie, branchee=binary_sensor.xxx_branchee, autonomie=sensor.xxx_autonomie,
#   charge=sensor.xxx_etat_de_charge, activite=sensor.xxx_derniere_activite_de_la_batterie, restant=sensor.xxx_temps_restant,
#   charger=button.xxx_commencer_la_charge, clim=button.xxx_demarrer_la_climatisation, phares=button.xxx_faire_un_appel_de_phares,
#   klaxon=button.xxx_klaxonner, charge_min=number.xxx_niveau_de_charge_minimal, charge_cible=number.xxx_niveau_de_charge_cible
# (sur une seule ligne). Le nom avant « : » est celui que le cadre affiche (jamais le nom de HA, qui contient la plaque).
# batterie et branchee obligatoires, le reste facultatif ; domaine imposé par rôle : sensor (binary_sensor pour
# branchee), button pour les 4 commandes, number pour les 2 niveaux ; jamais device_tracker ni select. Défaut : vide,
# « Voiture pas encore reliée ». Les entity_id contiennent souvent la plaque : à ne pas versionner.
VOITURES=
# Clims (intégration HACS « Bosch HomeCom », README « Clims »), deux au plus, séparées par « ; », sur une seule ligne :
# Salon: climat=climate.climatisation_salon, eco=switch.climatisation_salon_eco, boost=switch.climatisation_salon_boost,
#   sommeil=switch.climatisation_salon_sleep_mode, ioniseur=switch.climatisation_salon_ionizer,
#   pas_sur_moi=switch.climatisation_salon_wind_avoid_me, hors_gel=switch.climatisation_salon_8_degc_heating
# Le nom avant « : » est celui que le cadre affiche. climat (climate) obligatoire, les options (switch) facultatives.
# Défaut : vide, « Clims pas encore reliées ».
CLIMS=
# Lieu des prévisions Open-Meteo (air, pollens, pluie, semaine) et nom écrit après la date sur l'Accueil : les trois
# ensemble, ou aucune (défaut : Paris). Coordonnées en degrés décimaux, avec un point.
LIEU_NOM=
LIEU_LATITUDE=
LIEU_LONGITUDE=
# Immich, sans chemin (défaut : http://192.168.1.187:2283 ; en Docker : http://host.docker.internal:2283)
IMMICH_URL=
# Fichier secret de la clé API Immich, en 600, clé en LECTURE SEULE (permissions asset.read et asset.view). Défaut : vide,
# « Photos Immich à configurer », aucun appel à Immich. Donné mais fichier absent : même chose (message au démarrage).
IMMICH_CLE_FICHIER=
# Photos montrées : tout (au hasard dans toute la photothèque de l'utilisateur de la clé), favoris, ou album
# (défaut : tout). Jamais de vidéo, d'archivée, de dossier verrouillé ni de corbeille.
IMMICH_SOURCE=
# Avec IMMICH_SOURCE=album seulement : l'uuid de l'album (lu dans son adresse, /albums/<uuid>). Refusé sinon.
IMMICH_ALBUM_ID=
# 1 = faux Immich de démonstration (images fabriquées), avec npm run dev SEULEMENT : refusé au démarrage en production.
IMMICH_DEMO=
# 1 = faux Home Assistant de démonstration, avec npm run dev SEULEMENT et sans aucun ACTIONS_* à 1 (refusé sinon).
# Le plus simple est npm run demo, qui pose tout seul HA_DEMO, IMMICH_DEMO et des clés factices.
HA_DEMO=
# NODE_ENV n'est pas à mettre ici : npm run dev le pose à development (routes /dev, page servie depuis web/).
