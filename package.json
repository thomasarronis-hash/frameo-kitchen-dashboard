{
  "name": "cadre-cuisine",
  "version": "0.1.0",
  "description": "Serveur intermédiaire (BFF) de l'écran de cuisine : Home Assistant en liste blanche, Open-Meteo, flux SSE",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env serveur/index.js",
    "dev": "NODE_ENV=development node --env-file-if-exists=.env serveur/index.js",
    "demo": "node outils/demo.mjs",
    "test": "node --test tests/*.test.js",
    "verif-ha": "node --env-file-if-exists=.env outils/verif-ha.mjs",
    "verif-immich": "node --env-file-if-exists=.env outils/verif-immich.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "home-assistant-js-websocket": "9.7.1"
  }
}
